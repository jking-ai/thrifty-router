# GCP Project and Region
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1

# Vertex AI / Gemini
GEMINI_LOCATION=global
GEMINI_TIMEOUT_SECONDS=60

# API Authentication (Required in production)
API_KEY=your-secure-api-key-here

# Security and Limits
ALLOWED_ORIGINS=http://localhost:5173,https://thrifty-router.web.app
DOCS_ENABLED=false
DAILY_BUDGET_USD=2.0
COMPLETE_LIMITS=10/minute;200/day
MAX_PROMPT_CHARS=20000
MAX_OUTPUT_TOKENS=8192

# Embedding and Semantic Routing
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# Semantic Cache
CACHE_ENABLED=false
FIRESTORE_DATABASE=(default)

# Router Configuration File
ROUTER_CONFIG_PATH=app/router.yaml
